{
	"manifest_version": 3,
	"name": "AdVeil",
	"version": "0.2.0",
	"description": "Mute and blur ads on JioHotstar for a cleaner cricket experience.",
	"browser_specific_settings": {
		"gecko": {
			"id": "AdVeil@iShibi",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"icons": {
		"16": "icon16.png",
		"32": "icon32.png",
		"64": "icon64.png",
		"128": "icon128.png",
		"256": "icon256.png"
	},
	"action": {
		"default_popup": "src/popup/popup.html"
	},
	"permissions": ["webRequest", "storage", "tabs"],
	"host_permissions": ["*://*.hotstar.com/*"],
	"background": {
		"type": "module",
		"scripts": ["ServiceWorker.js"]
	},
	"content_scripts": [
		{
			"js": ["Content.js"],
			"matches": ["*://*.hotstar.com/*"]
		}
	]
}
