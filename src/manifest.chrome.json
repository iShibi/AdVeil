{
	"manifest_version": 3,
	"name": "AdVeil",
	"version": "0.4.0",
	"description": "Mute and blur ads on JioHotstar for a cleaner cricket experience.",
	"icons": {
		"16": "icon-on-16.png",
		"32": "icon-on-32.png",
		"64": "icon-on-64.png",
		"128": "icon-on-128.png",
		"256": "icon-on-256.png"
	},
	"action": {
		"default_popup": "src/popup/popup.html"
	},
	"permissions": ["webRequest", "storage", "tabs"],
	"host_permissions": ["*://*.hotstar.com/*"],
	"background": {
		"type": "module",
		"service_worker": "ServiceWorker.js"
	},
	"content_scripts": [
		{
			"matches": ["*://*.hotstar.com/*"],
			"js": ["Content.js"],
			"css": ["assets/output.css"]
		}
	]
}
