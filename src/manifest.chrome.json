{
	"manifest_version": 3,
	"name": "Mute Cricket Ads",
	"version": "0.1.0",
	"description": "Browser extentsion for muting ads during cricket match on JioHotstar.",
	"action": {
		"default_popup": "popup.html"
	},
	"permissions": [
		"webRequest",
		"tabs"
	],
	"host_permissions": [
		"*://*.hotstar.com/*"
	],
	"background": {
		"service_worker": "ServiceWorker.js",
		"type": "module"
	}
}
